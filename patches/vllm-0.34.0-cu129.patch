diff --git a/docker/Dockerfile b/docker/Dockerfile
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -632,5 +632,8 @@
 # Skip adding +precompiled suffix to version (preserves git-derived version)
 ENV VLLM_SKIP_PRECOMPILED_VERSION_SUFFIX=1

+# The CUDA 12.9 dependency patch dirties the tagged checkout.
+ENV VLLM_VERSION_OVERRIDE=0.34.0
+
 # Use existing torch for nightly and Rubin prerelease builds
 RUN --mount=type=cache,target=/opt/uv/cache \
@@ -1384,4 +1387,15 @@
 # See docs/deployment/docker.md.
 # USER vllm
 ENTRYPOINT ["vllm", "serve"]
+
+# Link the CUDA extensions on the CPU-only runner using the toolkit's driver stub.
+RUN --mount=type=bind,from=base,source=/usr/local/cuda-12.9/targets/x86_64-linux/lib/stubs,target=/tmp/cuda-stubs \
+    mkdir /tmp/cuda-smoke && \
+    ln -s /tmp/cuda-stubs/libcuda.so /tmp/cuda-smoke/libcuda.so.1 && \
+    LD_LIBRARY_PATH="/tmp/cuda-smoke:${LD_LIBRARY_PATH}" python3 -c 'import torch, torchvision, vllm; \
+        import vllm._C_stable_libtorch, vllm._moe_C_stable_libtorch; \
+        assert torch.version.cuda == "12.9", torch.version.cuda; \
+        assert torch.__version__ == "2.13.0+cu129", torch.__version__; \
+        assert vllm.__version__ == "0.34.0", vllm.__version__' && \
+    rm -r /tmp/cuda-smoke
 #################### OPENAI API SERVER ####################
